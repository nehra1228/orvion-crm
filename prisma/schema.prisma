generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPER_ADMIN
  SUPER_HR
  COMPANY_ADMIN
  BRANCH_MANAGER
  DEPARTMENT_MANAGER
  TEAM_LEADER
  EXECUTIVE
  TELECALLER
  HR
  MARKETING
  ACCOUNTS
  QA
  SUPPORT
}

enum BusinessType {
  REAL_ESTATE
  INSURANCE
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum LeadStatus {
  NEW
  CALLED
  INTERESTED
  FOLLOW_UP
  SITE_VISIT
  NEGOTIATION
  BOOKED
  LOST
}

enum LeadRemark {
  INTERESTED
  NOT_INTERESTED
  BUSY
  SWITCH_OFF
  WRONG_NUMBER
  CALLBACK
  NO_ANSWER
  SITE_VISIT
  BOOKED
  LOST
}

model Company {
  id           String         @id @default(cuid())
  name         String
  code         String         @unique
  businessType BusinessType   @default(REAL_ESTATE)
  status       CompanyStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  departments  Department[]
  teams        Team[]
  users        User[]
  leads        Lead[]
}

model Department {
  id           String           @id @default(cuid())
  name         String
  code         String
  companyId    String
  status       DepartmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teams        Team[]
  users        User[]
  leads        Lead[]

  @@unique([companyId, code])
}

model Team {
  id           String        @id @default(cuid())
  name         String
  code         String
  companyId    String
  departmentId String?
  status       CompanyStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  users        User[]
  leads        Lead[]

  @@unique([companyId, code])
}

model User {
  id            String      @id @default(cuid())
  username      String      @unique
  email         String?     @unique
  password      String
  role          Role
  active        Boolean     @default(true)
  fullName      String?
  companyId     String?
  departmentId  String?
  teamId        String?

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team          Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  leads         Lead[]      @relation("ExecutiveLeads")
  uploads       Upload[]
  activities    Activity[]
  attendances   Attendance[]
  campaigns     Campaign[]
  calls         Call[]
  executiveState ExecutiveState?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  LATE
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  day       String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model Lead {
  id            String      @id @default(cuid())
  name          String
  mobile        String
  project       String?
  city          String?
  source        String?
  status        LeadStatus  @default(NEW)
  remark        LeadRemark?
  notes         String?
  followUpDate  DateTime?
  companyId     String?
  departmentId  String?
  teamId        String?
  assignedToId  String?

  company       Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  team          Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedTo    User?       @relation("ExecutiveLeads", fields: [assignedToId], references: [id])

  activities    Activity[]
  calls         Call[]
  campaignId    String?
  campaign      Campaign?   @relation(fields: [campaignId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Upload {
  id           String   @id @default(cuid())
  filename     String
  totalLeads   Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

model Activity {
  id         String      @id @default(cuid())
  leadId     String
  userId     String
  oldStatus  LeadStatus?
  newStatus  LeadStatus?
  remark     LeadRemark?
  note       String?
  createdAt  DateTime    @default(now())

  lead       Lead        @relation(fields: [leadId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  ownerId     String?
  status      String   @default("DRAFT")
  totalLeads  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User?    @relation(fields: [ownerId], references: [id])
  leads       Lead[]
  calls       Call[]
}

model Call {
  id             String   @id @default(cuid())
  leadId         String
  campaignId     String?
  executiveId    String?
  providerCallId String?
  startedAt      DateTime?
  endedAt        DateTime?
  duration       Int?
  outcome        String?
  recordingUrl   String?
  metadata       Json?

  lead        Lead     @relation(fields: [leadId], references: [id])
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  executive   User?     @relation(fields: [executiveId], references: [id])
}

model RetryPolicy {
  id        String   @id @default(cuid())
  name      String
  rules     Json
  createdAt DateTime @default(now())
}

model ExecutiveState {
  id           String   @id @default(cuid())
  userId       String   @unique
  status       String   @default("OFFLINE")
  currentCall  String?
  lastSeen     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DialerConfig {
  id             String   @id @default(cuid())
  provider       String
  encryptedKey   String?
  config         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
